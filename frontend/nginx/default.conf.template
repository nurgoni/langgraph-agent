# Image `web` (F32): file statis hasil `pnpm build` dan proxy same-origin `/api/*` ke service,
# jadi browser tidak butuh CORS dan URL API tidak di-bake ke build (keputusan user F32).
# ${API_UPSTREAM} dan ${API_MAX_BODY_SIZE} diisi envsubst image nginx saat start; variabel nginx
# ($host, $uri) tidak disentuh karena bukan env var.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # `/api/auth/login` → `${API_UPSTREAM}/auth/login` (garis miring di akhir membuang prefix).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE (/stream): kirim setiap frame segera, dan biarkan model berpikir lama.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        # Upload artifact (F35): default nginx 1m. Service tetap menegakkan ARTIFACT_MAX_BYTES.
        client_max_body_size ${API_MAX_BODY_SIZE};
    }

    # Aset ber-hash dari Vite boleh di-cache selamanya.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Route SPA (React Router) selalu jatuh ke index.html, yang tidak di-cache.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
