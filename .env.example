# Copy to .env and fill in. See PRD.md section 8 for the full list.

# --- LLM (OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
DEFAULT_MODEL=gpt-5-mini
# Comma-separated allowlist; defaults to DEFAULT_MODEL when empty.
AVAILABLE_MODELS=
# Set to true to run without an API key (development and tests).
USE_FAKE_MODEL=false

# --- Persistence ---
SQLITE_DB_PATH=checkpoints.db

# --- Service ---
# When set, every endpoint except /health requires "Authorization: Bearer <AUTH_SECRET>".
AUTH_SECRET=
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# --- Client / UI ---
AGENT_URL=http://localhost:8080
