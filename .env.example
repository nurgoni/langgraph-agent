# Copy to .env and fill in. See PRD.md section 8 for the full list.

# --- LLM (OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
DEFAULT_MODEL=gpt-5-mini
# Comma-separated allowlist; defaults to DEFAULT_MODEL when empty.
AVAILABLE_MODELS=
# Set to true to run without an API key (development and tests).
USE_FAKE_MODEL=false
# Max tokens per model answer (reasoning tokens count too on Ollama). Defaults to 8192.
LLM_MAX_TOKENS=
# Request field for the limit: max_tokens (default; Ollama, vLLM, llama.cpp) or
# max_completion_tokens (OpenAI reasoning models such as gpt-5 and o-series). Ollama silently
# ignores max_completion_tokens, so leave this empty unless you use an OpenAI reasoning model.
LLM_MAX_TOKENS_PARAM=
# Token budget for the conversation history (plus its summary) sent on every model call.
# Older turns are summarized once the budget is reached. Defaults to 16000, minimum 1000.
CONTEXT_MAX_TOKENS=

# --- Tools ---
# Firecrawl API key for the web_search tool (https://firecrawl.dev). When empty, web search
# answers "not configured" and the agents keep working without it.
FIRECRAWL_API_KEY=

# --- Artifacts (F35) ---
# Folder for uploaded and generated files. Compose mounts the `artifacts` volume here.
# Defaults to data/artifacts (relative to the working directory).
ARTIFACT_DIR=
# Upload size limit in bytes. Defaults to 26214400 (25 MB). Behind the `web` proxy, also raise
# API_MAX_BODY_SIZE (nginx size, default 26m).
ARTIFACT_MAX_BYTES=

# --- Workspace tools (F36) ---
# Tool outputs larger than this many tokens are saved to the conversation workspace and the model
# gets a preview plus the file path. Defaults to 4000, minimum 100.
TOOL_OUTPUT_MAX_TOKENS=

# --- Evals (python -m agent_service.run_evals) ---
# Account used by the eval runner, ideally a service account:
#   python -m agent_service.manage create-user evals --role service
EVAL_USERNAME=
EVAL_PASSWORD=

# --- Persistence ---
# Postgres (ADR 0001). Defaults to the compose `postgres` service: docker compose up -d postgres
# Use 127.0.0.1, not localhost: on Docker Desktop for Windows, ::1 hangs until the timeout.
DATABASE_URL=postgresql://agent:agent@127.0.0.1:5432/agent_service

# --- Auth (per-user login) ---
# Required. Signs access tokens; use at least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Token lifetime in seconds (default 43200 = 12 hours). There is no refresh token.
JWT_TTL_SECONDS=
# Browser origins allowed to call the API (comma-separated), e.g. the React frontend.
CORS_ORIGINS=

# --- Service ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# --- Client / UI ---
AGENT_URL=http://localhost:8080
